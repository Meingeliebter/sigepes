# Este repositorio es un monorepo: frontend/ y backend/ tienen su propio
# .gitignore para sus artefactos de build. Aquí solo van reglas de la raíz.

# Configuración local de editores/herramientas (no compartida entre el equipo)
.vscode/
.idea/
.claude/
.impeccable/
.github/hooks/
.github/modernize/

# Sistema operativo
.DS_Store
Thumbs.db

# Secretos del stack docker compose (ver .env.example)
.env

# Archivos subidos en ejecución local (adjuntos, fotos de denuncias)
backend/uploads/
uploads/
