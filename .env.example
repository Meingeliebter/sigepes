# Copia este archivo como .env (no se versiona) y cambia los valores antes de levantar el stack.
POSTGRES_DB=sigepes
POSTGRES_USER=sigepes
POSTGRES_PASSWORD=cambia-esta-clave
# Mínimo 32 caracteres aleatorios. Genera uno con: openssl rand -base64 48
JWT_SECRET=
FRONTEND_URL=http://localhost:8081
SEED_DEMO_DATA=true
FRONTEND_PORT=8081

# Google Maps (opcional). Clave de navegador de Maps JavaScript API restringida por dominio.
# Sin clave, o sin señal, la app usa el mapa esquemático sin conexión.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
