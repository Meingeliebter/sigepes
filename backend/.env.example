# Copia este archivo a .env y ajusta los valores. NUNCA subas el .env real al repositorio.

# --- Base de datos ---------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/sigepes
DATABASE_USER=sigepes
DATABASE_PASSWORD=sigepes

# Credenciales del contenedor de PostgreSQL (docker compose)
POSTGRES_DB=sigepes
POSTGRES_USER=sigepes
POSTGRES_PASSWORD=sigepes
POSTGRES_PORT=5432

# --- Seguridad -------------------------------------------------------
# Mínimo 32 caracteres (256 bits) porque los tokens se firman con HS256.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-32-bytes
JWT_EXPIRATION_SECONDS=86400
LOGIN_ATTEMPTS_PER_MINUTE=10

# --- API y frontend --------------------------------------------------
API_PORT=8080
# Orígenes permitidos por CORS, separados por comas.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# --- Reglas de negocio -----------------------------------------------
# Días de antelación con los que se avisa de un permiso próximo a vencer.
PERMIT_EXPIRY_WARNING_DAYS=30

# --- Datos de demostración -------------------------------------------
# true carga los datos DEMO si la base está vacía. Ponlo en false en producción.
SEED_DEMO_DATA=true
